# SIH26107 - AI-Powered Intelligent Assistant for Indian Standards & BIS Services
# Environment Configuration

# Application
APP_NAME="BIS-IntelliAssist API"
APP_ENV="development"
DEBUG=true
PORT=8000
HOST="0.0.0.0"

# Mode & Safety
DEMO_MODE=true
STRICT_CITATION_GUARDRAIL=true

# Database (PostgreSQL URL or SQLite fallback)
# For Postgres: postgresql://postgres:postgres@localhost:5432/bis_db
DATABASE_URL="sqlite:///./data/bis_assistant.db"

# Qdrant Vector Search
# For remote: QDRANT_URL="http://localhost:6333"
# For embedded/local: Leave QDRANT_URL empty and set QDRANT_STORAGE_PATH
QDRANT_URL=""
QDRANT_API_KEY=""
QDRANT_STORAGE_PATH="./data/qdrant"
QDRANT_COLLECTION_NAME="bis_standards_chunks"

# LLM Providers
LLM_PROVIDER="gemini" # gemini, openai, ollama, demo
GEMINI_API_KEY="AIzaSy-demo-placeholder"
GEMINI_MODEL="gemini-1.5-flash"
OPENAI_API_KEY="sk-demo-placeholder"
OPENAI_MODEL="gpt-4o-mini"
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="llama3.1"

# Embeddings
EMBEDDING_PROVIDER="tfidf_semantic" # tfidf_semantic, openai, local_transformer
EMBEDDING_DIMENSION=384

# Logging
LOG_LEVEL="INFO"
